# =============================================================================
# BloodBridge – Smart Donor Connect Environment Configuration
# =============================================================================
#
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and "anon / public" API key
# 4. In this project, create or edit your ".env.local" file and paste your credentials:
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
#
# Google Cloud / Firebase Firestore Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
#
# =============================================================================
# Resend Transactional Email Configuration (SERVER-SIDE ONLY)
# =============================================================================
# 1. Sign up at https://resend.com and obtain your API key from API Keys tab
# 2. IMPORTANT: Do NOT prefix with VITE_ to keep it 100% server-side!
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=BloodBridge <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=bloodbridgesupportweb@gmail.com
BLOODBRIDGE_SUPPORT_EMAIL=bloodbridgesupportweb@gmail.com
RESEND_DEV_FALLBACK_EMAIL=your-verified-resend-account@gmail.com
#
# =============================================================================
# Public Application / Edge Function URL (MANDATORY FOR PRODUCTION EMAILS)
# =============================================================================
# Emails must NEVER contain localhost URLs. Configure your public HTTPS domain here:
# (e.g. https://bloodbridge.org, or your deployed Supabase URL, or ngrok tunnel)
APP_PUBLIC_URL=https://bloodbridge.org
#
# IMPORTANT:
# - NEVER commit your real credentials or service-role keys to source control.
# =============================================================================

