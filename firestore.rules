rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blood_requests/{requestId} {
      allow read, write: if true;
    }
    match /blood_request_matches/{matchId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
